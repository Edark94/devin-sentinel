# ---- Devin -------------------------------------------------------------
# Personal API key (apk_user_*) or service-user key (apk_*) from app.devin.ai -> Settings -> API keys
DEVIN_API_KEY=apk_user_xxx
# Optional. Resolved automatically from GET /v3/self when empty.
DEVIN_ORG_ID=
# Real API. In simulate mode docker-compose overrides this to the bundled fake.
DEVIN_API_BASE=https://api.devin.ai
# Hard budget per session (1 ACU ~ 15 min of Devin work). Sessions are stopped by Devin at this cap.
DEVIN_MAX_ACU_PER_SESSION=10
# devin_mode override: normal | fast | lite | ultra (empty = org default)
DEVIN_MODE=

# ---- GitHub ------------------------------------------------------------
# Fine-grained or classic token with issues:write + pull_requests:read on the target repo
GITHUB_TOKEN=ghp_xxx
# The fork Devin works on. PRs are opened against this repo, never upstream.
GITHUB_REPO=Edark94/superset
GITHUB_DEFAULT_BRANCH=master
# Secret configured on the GitHub webhook (X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=change-me
# Set to 1 to log GitHub writes (comments/labels) instead of performing them
GITHUB_DRY_RUN=0

# ---- Orchestration policy ----------------------------------------------
TRIGGER_LABEL=devin:remediate
MAX_CONCURRENT_SESSIONS=3
POLL_INTERVAL_SECONDS=30
# Scheduled trigger: sweep the repo for labelled issues that have no task yet (0 = disabled)
ISSUE_SWEEP_INTERVAL_SECONDS=300
SESSION_TIMEOUT_MINUTES=90
MAX_RETRIES=1
# How many times to auto-answer "waiting_for_user" before escalating to a human
MAX_NUDGES=2

# ---- Service -----------------------------------------------------------
SENTINEL_DB_PATH=/data/sentinel.db
LOG_LEVEL=INFO
